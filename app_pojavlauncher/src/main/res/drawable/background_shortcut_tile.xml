<?xml version="1.0" encoding="utf-8"?>
<!--
    Bloco de atalho da tela inicial. Ripple para dar retorno ao toque, que os
    botoes antigos (background transparente) nao tinham de forma consistente.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#332ECC71">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_12sdp" />
            <solid android:color="@color/background_card" />
            <stroke
                android:width="1dp"
                android:color="@color/background_overlay" />
        </shape>
    </item>
</ripple>
