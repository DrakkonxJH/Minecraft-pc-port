<?xml version="1.0" encoding="utf-8"?>
<!--
    Cartao de destaque do perfil ativo na tela inicial.
    Degrade sutil do grafite para um tom levemente esverdeado, para separar o
    bloco "o que vou jogar" do resto da tela sem usar uma cor chapada.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/_16sdp" />
    <gradient
        android:startColor="#1B2127"
        android:endColor="#16221C"
        android:angle="270" />
    <stroke
        android:width="1dp"
        android:color="#2A3A31" />
</shape>
